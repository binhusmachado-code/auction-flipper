# Browser-safe account configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Used only as a fallback when Supabase Edge Functions are unavailable.
VITE_API_BASE_URL=

# Server-only account configuration. Never prefix these with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
APP_URL=https://YOUR_APP_DOMAIN/OPTIONAL_BASE_PATH
# Comma-separated browser origins allowed to call the Vercel account API.
ALLOWED_APP_ORIGINS=https://binhusmachado-code.github.io,https://YOUR_APP.vercel.app
# Stripe Billing: create recurring USD Prices matching the published plans.
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_INVESTOR_MONTHLY=price_...
STRIPE_PRICE_INVESTOR_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
