# Browser-safe account configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_BILLING_ENABLED=false
VITE_MEMBERSHIP_ENABLED=false
# Used only as a fallback when Supabase Edge Functions are unavailable.
VITE_API_BASE_URL=

# Server-only Vercel configuration for billing. Never prefix these with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_YEARLY=price_REPLACE_ME
APP_URL=https://YOUR_APP_DOMAIN/OPTIONAL_BASE_PATH
# Comma-separated browser origins allowed to call the Vercel account API.
ALLOWED_APP_ORIGINS=https://binhusmachado-code.github.io,https://YOUR_APP.vercel.app
